# Ne jamais commiter .env réel. Générer chaque secret hors Git, sans l'afficher.
TRANSLATOR_ENVIRONMENT=local
TRANSLATOR_JWT_SECRET=<generate-at-least-32-random-characters>
TRANSLATOR_DATABASE_URL=postgresql+psycopg://translator:<db-password>@postgres:5432/translator
TRANSLATOR_DATA_DIR=/app/runtime
TRANSLATOR_EXPECTED_DIR=/app/dataset/expected
TRANSLATOR_STORAGE_BACKEND=s3
TRANSLATOR_S3_BUCKET=documents-private
TRANSLATOR_S3_ENDPOINT_URL=http://minio:9000
TRANSLATOR_S3_REGION=us-east-1
TRANSLATOR_EXECUTION_MODE=celery
TRANSLATOR_CELERY_BROKER_URL=redis://:<redis-password>@redis:6379/0
TRANSLATOR_ALLOWED_ORIGINS=http://localhost:8080
TRANSLATOR_ENGINE=offline
# Requis uniquement avec TRANSLATOR_ENGINE=private; aucun téléchargement n'est effectué.
TRANSLATOR_PRIVATE_AI_BASE_URL=
TRANSLATOR_PRIVATE_AI_ALLOWED_HOSTS=
TRANSLATOR_PRIVATE_AI_MODEL=
TRANSLATOR_PRIVATE_AI_API_KEY=
TRANSLATOR_TOKENIZER_PATH=/models/qwen-tokenizer
TRANSLATOR_MAX_CONTEXT=32768
TRANSLATOR_TARGET_INPUT=22000
TRANSLATOR_MAX_OUTPUT=8000
TRANSLATOR_SAFETY_MARGIN=2768
# OCR : Surya par défaut (service ocr-surya sur le réseau interne). Tesseract uniquement sur
# sélection explicite (référence historique) ; aucun repli automatique d'un moteur vers l'autre.
# Poids Surya : licence OpenRAIL-M modifiée, éligibilité à attester (docs/ocr/SURYA.md).
TRANSLATOR_OCR_BACKEND=surya
TRANSLATOR_SURYA_OCR_URL=http://ocr-surya:8093
TRANSLATOR_SURYA_OCR_ALLOWED_HOSTS=ocr-surya
TRANSLATOR_SURYA_WEIGHTS_LICENSE_ACKNOWLEDGED=false
OCR_SURYA_TOKEN=<generate-random-token>
OCR_SURYA_MODEL_FILE=surya-2.5-Q8_0.gguf
OCR_SURYA_THREADS=4
# Temporaire, jamais en production/private : TRANSLATOR_ENGINE=interim.
# Le serveur peut utiliser OPENAI_API_BASE/OPENAI_API_KEY déjà injectés ; jamais côté client/Git.
TRANSLATOR_INTERIM_MODEL=gpt-5-mini
TRANSLATOR_INTERIM_API_BASE=
TRANSLATOR_INTERIM_API_KEY=
TRANSLATOR_INTERIM_DATA_SCOPE=synthetic_fixture
TRANSLATOR_INTERIM_SYNTHETIC_PAYLOAD_SHA256_ALLOWLIST=
# Contrat officiel max_completion_tokens : borne totale visible + reasoning, vérifiée par sondes synthétiques.
TRANSLATOR_INTERIM_TOTAL_GENERATION_CAP_VERIFIED=true
TRANSLATOR_INTERIM_CAPABILITY_PROOF=
# Retour Qwen : engine=private + endpoint/model/version/tokenizer/allowlist privés correspondants.
POSTGRES_DB=translator
POSTGRES_USER=translator
POSTGRES_PASSWORD=<generate-random-db-password>
REDIS_PASSWORD=<generate-random-redis-password>
MINIO_ROOT_USER=<generate-random-minio-user>
MINIO_ROOT_PASSWORD=<generate-random-minio-password>
MINIO_BUCKET=documents-private
FRONTEND_PORT=8080

# DEV/QA uniquement. Générer 32 octets aléatoires en base64 ; conserver la clé tant que des objets chiffrés existent.
# En production : remplacer ce MinIO de laboratoire par un S3 avec KMS/KES/Vault géré et audité.
MINIO_KMS_SECRET_KEY=dev-only:REPLACE_WITH_BASE64_OF_32_RANDOM_BYTES
