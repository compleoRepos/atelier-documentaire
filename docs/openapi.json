              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "LoginIn": {
        "properties": {
          "username": {
            "type": "string",
            "maxLength": 190,
            "minLength": 1,
            "title": "Username"
          },
          "password": {
            "type": "string",
            "maxLength": 1024,
            "minLength": 1,
            "title": "Password"
          }
        },
        "type": "object",
        "required": [
          "username",
          "password"
        ],
        "title": "LoginIn"
      },
      "MemoryIn": {
        "properties": {
          "source": {
            "type": "string",
            "maxLength": 500,
            "minLength": 1,
            "title": "Source"
          },
          "target": {
            "type": "string",
            "maxLength": 500,
            "minLength": 1,
            "title": "Target"
          },
          "domain": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 100
              },
              {
                "type": "null"
              }
            ],
            "title": "Domain"
          }
        },
        "type": "object",
        "required": [
          "source",
          "target"
        ],
        "title": "MemoryIn"
      },
      "ReviewIn": {
        "properties": {
          "action": {
            "type": "string",
            "title": "Action"
          },
          "corrections": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object",
            "title": "Corrections"
          },
          "protected_entities": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Protected Entities"
          },
          "protected_regions": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "title": "Protected Regions"
          },
          "comment": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 2000
              },
              {
                "type": "null"
              }
            ],
            "title": "Comment"
          },
          "attest_review": {
            "type": "boolean",
            "title": "Attest Review",
            "default": false
          },
          "promote_golden": {
            "type": "boolean",
            "title": "Promote Golden",
            "default": false
          },
          "expected_version": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Expected Version"
          },
          "ocr_text": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 500000
              },
              {
                "type": "null"
              }
            ],
            "title": "Ocr Text"
          },
          "attest_ocr": {
            "type": "boolean",
            "title": "Attest Ocr",
            "default": false
          },
          "quality_rubric": {
            "anyOf": [
              {
                "additionalProperties": {
                  "type": "number"
                },
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Quality Rubric"
          }
        },
        "type": "object",
        "required": [
          "action"
        ],
        "title": "ReviewIn"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
