        ],
        "title": "Body_upload_api_documents_post"
      },
      "GlossaryIn": {
        "properties": {
          "source": {
            "type": "string",
            "maxLength": 500,
            "minLength": 1,
            "title": "Source"
          },
          "target": {
            "type": "string",
            "maxLength": 500,
            "minLength": 1,
            "title": "Target"
          },
          "domain": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 100
              },
              {
                "type": "null"
              }
            ],
            "title": "Domain"
          }
        },
        "type": "object",
        "required": [
          "source",
          "target"
        ],
        "title": "GlossaryIn"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
